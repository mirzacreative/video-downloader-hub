# Copy to .env and adjust. The server reads these at startup.
# Port the API listens on.
PORT=3000
# Path to the yt-dlp binary (default: yt-dlp on PATH).
YT_DLP_PATH=yt-dlp
# Optional: path to a cookies file, ONLY if you knowingly use your own
# account cookies to fetch login-walled content. Do NOT commit cookies.
# COOKIES_FILE=
# Max seconds allowed for a metadata fetch.
INFO_TIMEOUT_MS=60000
